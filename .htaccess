# ============================================================================
#  Aqua — configurazione del server (Aruba Hosting Linux, Apache)
# ============================================================================

# Nessun elenco dei file quando si apre una cartella senza index.html
Options -Indexes

# Pagina "non trovata" del sito
ErrorDocument 404 /404.html

# Testi in UTF-8 (lettere accentate e simbolo €)
AddDefaultCharset UTF-8

# ---------- Tipi di file ----------
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .properties .txt .xml .webmanifest .svg
  AddType text/plain                .properties
  AddType application/manifest+json .webmanifest
  AddType text/javascript           .js
  AddType image/svg+xml             .svg
  AddType font/woff2                .woff2
  AddType video/mp4                 .mp4
</IfModule>

# ---------- HTTPS e www ----------
# ATTIVARE SOLO DOPO che il certificato SSL funziona: togliere il "#" all'inizio delle 6 righe
# e sostituire tuodominio.it con il dominio reale.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^ https://www.tuodominio.it%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------- Compressione (pagine e testi più leggeri) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml
</IfModule>

# ---------- Cache del browser ----------
# Pagine e file dei contenuti (data/*.properties): sempre aggiornati.
# Stili, script, font, foto e video: conservati 30 giorni (i CSS e JS cambiano nome con ?v=…).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 hour"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/plain                "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 0 seconds"
  ExpiresByType text/xml                  "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType text/css                  "access plus 30 days"
  ExpiresByType text/javascript           "access plus 30 days"
  ExpiresByType application/javascript    "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 30 days"
</IfModule>

# ---------- Protezioni di base ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
